# 智能问数 v2 · 真实依赖环境变量（复制为 .env 或直接 export/set）
# 认证一律走 AWS 凭证链（~/.aws 或环境变量），无密码留空。

# AWS 区域
AWS_REGION=us-west-2

# —— Bedrock 模型（单一切换点：改这里即可换模型）——
# 已实测可用；旧版 Claude 3/3.5 在本账号已被标记 Legacy/EOL 不可用。
SMARTQUERY_LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
SMARTQUERY_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
SMARTQUERY_EMBED_DIM=1024

# —— OpenSearch Serverless（由 scripts/create_aoss_collection.py 输出 endpoint）——
SMARTQUERY_OPENSEARCH_ENDPOINT=https://cqo59tw52rympj7xvdqd.us-west-2.aoss.amazonaws.com
SMARTQUERY_OPENSEARCH_INDEX=smartquery-vectors

# —— DynamoDB 限流表（由 scripts/create_dynamodb_table.py 创建）——
SMARTQUERY_DDB_TABLE=api_gateway_rate_limit
SMARTQUERY_USER_RATE_LIMIT=200

# —— AgentCore Memory（多轮会话短期记忆，由 scripts/create_agentcore_memory.py 创建）——
# 不设则回退进程内 InMemoryMemory（非持久，仅本地）
SMARTQUERY_MEMORY_ID=smart_query_memory-m4IH8j7Ren
